# Copy locally; never commit real credentials. Compose forwards these explicitly.
GRPC_AUTH_TOKEN=replace-with-service-token
GEMINI_API_KEY=
# Select a model enabled for your account that supports native JSON schema.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# Shared by assessment + solution generation, not 30s per invocation.
GEMINI_MAX_OUTPUT_TOKENS=2048
# UTF-8 bytes of each complete model prompt; oversized input is rejected.
CONSULTATION_MAX_CONTEXT_BYTES=120000
# Raw consultation content must not be sent to external tracing.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
