# Copy locally; never commit real credentials. Compose forwards these explicitly.
GRPC_AUTH_TOKEN=replace-with-service-token
# --- LLM provider: OpenAI (replaces Gemini since 2026-11-14) ---
# One key for both paths. Data sent to OpenAI: feedback text, shop profile and
# consultation context (never customer names); see docs/deploy-checklist.md.
OPENAI_API_KEY=
# Optional; empty = the model's default temperature (some reasoning models reject 0).
LLM_TEMPERATURE=

# --- Path B: ProcessConsultationTurn (assessment + solution + relevance check) ---
CONSULTATION_MODEL=gpt-6.1-terra
# Total turn budget (assessment + solution); Go's AI_CONSULTATION_TIMEOUT is 60 s.
CONSULTATION_TIMEOUT_SECONDS=45
# Per call (assessment / solution).
CONSULTATION_MAX_OUTPUT_TOKENS=2048
# UTF-8 bytes of each complete model prompt; oversized input is rejected.
CONSULTATION_MAX_CONTEXT_BYTES=120000
# Optional: none|minimal|low|medium|high for reasoning models; empty = model default.
CONSULTATION_REASONING_EFFORT=
# Official standard-tier prices per 1M tokens (USD), only for cost metrics in logs.
CONSULTATION_PRICE_INPUT_PER_1M_USD=1.00
CONSULTATION_PRICE_OUTPUT_PER_1M_USD=5.00
# B2 relevance check for consultation advice (one extra call per Solution).
# Fails open on provider errors.
CONSULTATION_RELEVANCE_CHECK=true
CONSULTATION_RELEVANCE_TIMEOUT_SECONDS=10

# --- Path A: ProcessFeedback (extraction + merge judge), separate from Path B ---
# Required for Path A; never falls back to CONSULTATION_MODEL.
FEEDBACK_MODEL=gpt-6-luna
# Provisional defaults, not tuned values. Go AI_FEEDBACK_TIMEOUT defaults to 30s.
FEEDBACK_EXTRACTION_TIMEOUT_SECONDS=20
FEEDBACK_MAX_OUTPUT_TOKENS=1024
FEEDBACK_MAX_CONTEXT_BYTES=32000
FEEDBACK_REASONING_EFFORT=
FEEDBACK_PRICE_INPUT_PER_1M_USD=0.10
FEEDBACK_PRICE_OUTPUT_PER_1M_USD=0.50
FEEDBACK_MAX_OPINIONS=10
FEEDBACK_MAX_TEXT_CHARS=5000
# E5 embeddings (bundled in the Docker image; set a local path when running outside Docker).
FEEDBACK_EMBEDDING_MODEL_DIR=/opt/models/multilingual-e5-small
# Provisional ONNX Runtime intra-op threads.
FEEDBACK_EMBEDDING_THREADS=2
# Issue matching (P-A5). Provisional, NOT calibrated: the threshold only decides
# whether the LLM merge judge is consulted; E5 similarity never merges alone.
FEEDBACK_MATCH_THRESHOLD=0.85
FEEDBACK_MATCH_TOP_K=3
FEEDBACK_MATCH_TIMEOUT_SECONDS=10
FEEDBACK_MATCH_JUDGE=true

# --- gRPC server (defaults match Go's client) ---
GRPC_MAX_WORKERS=8
# In-flight RPC cap; beyond it the server answers RESOURCE_EXHAUSTED instead of queueing.
GRPC_MAX_CONCURRENT_RPCS=32
GRPC_MAX_MESSAGE_BYTES=4194304
# Optional TLS (set both; Go then needs AI_GRPC_TLS=true and a certificate its
# system roots trust). Empty = plaintext on a private Docker network.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
# Certificate DNS name used by the container healthcheck when TLS is on.
GRPC_TLS_SERVER_NAME=

# --- Observability ---
# Optional local JSONL of per-RPC records (IDs, durations, tokens, cost; never text).
ATLAS_TRACE_FILE=
# Raw consultation content must not be sent to external tracing.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Evaluation runner only: explicit --remote-setup / --live / --remote-upload.
# These credentials are NOT forwarded to the production container by compose.yaml.
# Keep production tracing disabled; never commit a real API key.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional when the API key needs an explicit workspace selection.
LANGSMITH_WORKSPACE_ID=
